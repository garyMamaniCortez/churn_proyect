# Copy this file to `.env` and fill in real values. NEVER commit the real `.env`.

# --- Postgres connection (gym operational database) ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=gym_db
DB_USER=change_me
DB_PASSWORD=change_me

# --- Business parameters ---
# Days of grace after fecha_vencimiento before a client is labeled as churned.
CHURN_GRACE_DAYS=30
